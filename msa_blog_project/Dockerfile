# Используем актуальный и поддерживаемый образ с Java 17
FROM eclipse-temurin:17-jdk-jammy

# Создаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем собранный jar-файл из папки target в контейнер
# (Звездочка * позволяет скопировать файл с любым именем, если версия меняется)
COPY target/*.jar app.jar

# Открываем порт 8080 (стандартный порт Spring Boot)
EXPOSE 8080

# Команда для запуска приложения
ENTRYPOINT ["java", "-jar", "app.jar"]